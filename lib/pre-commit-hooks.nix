{ pkgs, tofu-github }:
# Org-wide pre-commit hook defaults for cachix/git-hooks.nix consumers.
#
# Consumers import the result into `pre-commit.settings.hooks`:
#
#   pre-commit.settings.hooks =
#     (inputs.nix-devenv.lib.mkPreCommitHooks { inherit pkgs; })
#     // {
#       # Per-repo additions or overrides go here (e.g. treefmt, which
#       # needs `package = config.treefmt.build.wrapper` from the local
#       # treefmt-nix config).
#     };
#
# Why a function, not a static attrset: hooks use packages resolved against
# the consumer's nixpkgs pin, not nix-devenv's.
#
# treefmt is intentionally NOT included: its `package` field must point
# at the consumer's locally-configured treefmt wrapper, which only the
# consumer can name.
let
  # Start-anchored, no trailing $: gitlint and GitHub match the whole message.
  commitMessagePattern = pkgs.lib.removeSuffix "\n" (
    pkgs.lib.fileContents "${tofu-github}/config/commit-message-pattern.txt"
  );
in
{
  # Nix-source hygiene
  deadnix.enable = true;
  statix.enable = true;

  # Generic file hygiene
  check-yaml.enable = true;
  check-toml.enable = true;
  check-json.enable = true;
  check-merge-conflicts.enable = true;
  check-added-large-files = {
    enable = true;
    args = [ "--maxkb=500" ];
  };
  end-of-file-fixer.enable = true;
  # `--markdown-linebreak-ext=md` preserves Markdown's two-space line
  # breaks (where trailing whitespace is semantic, not garbage).
  trim-trailing-whitespace = {
    enable = true;
    args = [ "--markdown-linebreak-ext=md" ];
  };

  # Secret detection
  detect-private-keys.enable = true;

  # This workstation-only list is installed from its private host config.
  # Public contributors without it get one warning and continue.
  private-identifiers = {
    enable = true;
    name = "private-identifier-staged-additions";
    entry = "${pkgs.bash}/bin/bash";
    args = [
      "-c"
      ''
        list_file="$HOME/.config/gh-guard/identifiers.txt"
        if [ ! -f "$list_file" ]; then
          printf '%s\n' "warning: private identifier list is absent; skipping local scan" >&2
          exit 0
        fi
        if [ ! -r "$list_file" ]; then
          printf '%s\n' "error: private identifier list is unreadable" >&2
          exit 1
        fi

        set -o pipefail
        git diff --cached --unified=0 --no-ext-diff --no-color -- |
          ${pkgs.gawk}/bin/awk -v list_file="$list_file" '
            BEGIN {
              while ((getline term < list_file) > 0) {
                sub(/\r$/, "", term)
                sub(/^[[:space:]]+/, "", term)
                sub(/[[:space:]]+$/, "", term)
                if (term == "" || term ~ /^#/) continue
                terms[++term_count] = tolower(term)
              }
              close(list_file)
            }
            /^diff --git / { path = ""; next }
            /^\+\+\+ / {
              path = substr($0, 5)
              sub(/^b\//, "", path)
              next
            }
            /^@@ / {
              line = $0
              sub(/^.*\+/, "", line)
              sub(/,.*/, "", line)
              sub(/ .*/, "", line)
              line_number = line + 0
              next
            }
            /^\+/ {
              added = tolower(substr($0, 2))
              for (i = 1; i <= term_count; i++) {
                if (index(added, terms[i]) > 0) {
                  printf "%s:%d: private identifier\n", path, line_number
                  failed = 1
                  break
                }
              }
              line_number++
              next
            }
            /^ / { line_number++; next }
            END { exit failed }
          '
      ''
    ];
    language = "system";
    pass_filenames = false;
    always_run = true;
  };

  # Markdown linting. markdownlint-cli2 has no native git-hooks.nix
  # wrapper, so configure it as a custom hook backed by the nixpkgs
  # package. CHANGELOG.md is auto-generated by release-please; its
  # commit-hash URLs trigger MD013 and per-release section headings
  # trigger MD024.
  markdownlint-cli2 = {
    enable = true;
    name = "markdownlint-cli2";
    entry = "${pkgs.markdownlint-cli2}/bin/markdownlint-cli2";
    files = "\\.md$";
    excludes = [ "^CHANGELOG\\.md$" ];
    language = "system";
    pass_filenames = true;
  };

  # Conventional Commit subject validation on the message file. gitlint's
  # default merge-commit ignore keeps git-flow merge commits out of this rule.
  conventional-commit-subject = {
    enable = true;
    name = "conventional-commit-subject";
    entry = "${pkgs.gitlint}/bin/gitlint";
    args = [
      "--ignore"
      "T1,T2,T3,T4,T5,T6,T8,B1,B2,B3,B4,B5,B6,B7,B8"
      "-c"
      "title-match-regex.regex=${commitMessagePattern}"
      "--msg-filename"
    ];
    stages = [ "commit-msg" ];
    language = "system";
    pass_filenames = true;
  };

  # GitHub Actions workflow security via zizmor. Persona/severity/
  # confidence chosen to match prior .pre-commit-config.yaml usage
  # across consuming repos.
  zizmor = {
    enable = true;
    files = "^\\.github/workflows/.*\\.ya?ml$";
    args = [
      "--persona=regular"
      "--min-severity=medium"
      "--min-confidence=medium"
    ];
  };
}
